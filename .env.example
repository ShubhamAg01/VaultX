PORT=3000
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-64-chars

# Local SQLite (Default if Turso is not configured)
DB_PATH=./vault.db

# Turso Cloud Database (Optional — recommended for 24/7 cloud deployment on Render)
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Render Free-Tier Keep-Alive (Pings /health every 14 minutes to prevent sleeping)
# KEEP_ALIVE_URL=https://vaultx-xxxx.onrender.com
